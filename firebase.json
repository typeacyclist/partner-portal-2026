{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/solution-builder.html",
        "destination": "/discover.html",
        "type": 301
      },
      {
        "source": "/solution-builder",
        "destination": "/discover",
        "type": 301
      },
      {
        "source": "/products.html",
        "destination": "/discover.html",
        "type": 301
      },
      {
        "source": "/products",
        "destination": "/discover",
        "type": 301
      },
      {
        "source": "/case-studies.html",
        "destination": "/discover.html",
        "type": 301
      },
      {
        "source": "/case-studies",
        "destination": "/discover",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/send-proposal",
        "function": {
          "functionId": "sendProposal",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/send-contact",
        "function": {
          "functionId": "sendContact",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/send-password-reset",
        "function": {
          "functionId": "sendPasswordReset",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/send-user-invite",
        "function": {
          "functionId": "sendUserInvite",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/internal/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      },
      {
        "source": "/assets/portal-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "runtime": "nodejs20"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
