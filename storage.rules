rules_version = '2';

// Firebase Storage security rules
// Deploy with: firebase deploy --only storage
//
// Public read is allowed only for partner enablement media folders used by
// the static Firebase-hosted portal. These are referenced by browser-native
// image, audio, video, and PDF URLs.
//
// All other files remain readable only by authenticated users.
// Client-side writes are blocked globally.

service firebase.storage {
  match /b/{bucket}/o {
    // Public partner-portal media and document assets
    match /site_icons/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /audio_podcast_explainer/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /exec_summary_reports_pdf/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /infographics/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /slide_decks/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /video_explainers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default: signed-in users can read other files; no client writes.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
