rules_version = '2';

// Firebase Storage security rules
// Deploy with: firebase deploy --only storage
//
// Rule: only authenticated users can read files. No one can write except
// via the Firebase console (admins) or Cloud Functions using the Admin SDK.
//
// If you need some files to be publicly readable (e.g. a promo video
// on the unauthenticated marketing page), add a separate `match` block
// with `allow read;` for that specific path prefix.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Any signed-in user can read any file
      allow read: if request.auth != null;

      // No client-side writes. Admins upload via the Firebase console;
      // programmatic uploads use the Admin SDK in Cloud Functions.
      allow write: if false;
    }
  }
}
